@startuml
title Season sport and division configuration
skinparam shadowing false
start
if (Configuration action?) then (create or edit)
  if (Sport or division?) then (sport)
    :Validate name and optional description;
  else (division)
    :Validate name, gender policy,\nand roster limits;
  endif
  if (Invalid or duplicate name?) then (yes)
    :Reject;
  else (no)
    :Save season-owned record;
  endif
else (delete)
  if (Division has registered teams?) then (yes)
    :Reject deletion;
  else (no)
    :Delete unused seasonal configuration;
  endif
endif
stop
legend bottom
  Names are scoped to the parent. Gender policy is stored,
  but player gender eligibility is not enforced yet.
endlegend
@enduml
