@startuml
title Create or remove season sports and divisions
skinparam shadowing false
start
:Administrator chooses season;
if (Planning or Registration?) then (yes)
else (no)
  :Reject configuration change;
  stop
endif
if (Action?) then (create)
  if (Create sport or division?) then (sport)
    :Enter sport details;
    if (Name already used in season?) then (yes)
      :Reject;
    else (no)
      :Save SeasonSport;
    endif
  else (division)
    :Enter division details for season sport;
    if (Name already used in sport?) then (yes)
      :Reject;
    else (no)
      :Save SeasonSportDivision;
    endif
  endif
else (remove)
  if (Assignment has registered teams?) then (yes)
    :Reject;
  else (no)
    :Remove seasonal configuration;
  endif
endif
stop
legend bottom
  Removal checks include archived teams. Removing
  a sport also removes its unused division links.
endlegend
@enduml
