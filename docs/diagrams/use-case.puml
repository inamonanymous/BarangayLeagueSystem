Encoder --> UC19
Encoder --> UC20
Encoder --> UC21

Viewer --> UC18
Viewer --> UC19
Viewer --> UC20
Viewer --> UC21
Viewer --> UC22
Viewer --> UC23
Viewer --> UC24
Viewer --> UC25
Viewer --> UC26

@enduml